<file path="internal/security/ratelimit.go">
package security

import (
	"sync"
	"time"
)

type registro struct {
	cuenta        int
	ventanaInicio time.Time
	bloqueoHasta  time.Time
}

// LimitadorLogin cuenta fallos por clave (IP o correo) y bloquea temporalmente.
// Vive en memoria: sirve para una sola instancia. Con varias, usa Redis.
type LimitadorLogin struct {
	mu          sync.Mutex
	registros   map[string]*registro
	maxIntentos int
	ventana     time.Duration
	bloqueo     time.Duration
}

const maxRegistros = 10_000

func NewLimitadorLogin(maxIntentos int, ventana, bloqueo time.Duration) *LimitadorLogin {
	return &LimitadorLogin{
		registros:   make(map[string]*registro),
		maxIntentos: maxIntentos,
		ventana:     ventana,
		bloqueo:     bloqueo,
	}
}

func (l *LimitadorLogin) Permitir(clave string) bool {
	l.mu.Lock()
	defer l.mu.Unlock()
	r, ok := l.registros[clave]
	return !ok || !time.Now().Before(r.bloqueoHasta)
}

func (l *LimitadorLogin) Fallo(clave string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	ahora := time.Now()
	r, ok := l.registros[clave]
	if !ok || ahora.Sub(r.ventanaInicio) > l.ventana {
		r = &registro{ventanaInicio: ahora}
		l.registros[clave] = r
	}
	r.cuenta++
	if r.cuenta >= l.maxIntentos {
		r.bloqueoHasta = ahora.Add(l.bloqueo)
		r.cuenta = 0
		r.ventanaInicio = ahora
	}
	if len(l.registros) > maxRegistros {
		l.podar(ahora)
	}
}

func (l *LimitadorLogin) Exito(clave string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	delete(l.registros, clave)
}

// podar elimina registros que ya no bloquean ni están dentro de la ventana.
func (l *LimitadorLogin) podar(ahora time.Time) {
	for k, r := range l.registros {
		if !ahora.Before(r.bloqueoHasta) && ahora.Sub(r.ventanaInicio) > l.ventana {
			delete(l.registros, k)
		}
	}
}
</file>

<file path="internal/security/sesion.go">
package security

import (
	"errors"
	"net/http"
	"os"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/golang-jwt/jwt/v5"
)

const (
	nombreCookie   = "sesion"
	duracionSesion = 8 * time.Hour
	emisor         = "gestor-gastos"
)

var secreto []byte

type Identidad struct {
	Email    string `json:"email"`
	Username string `json:"username"`
	jwt.RegisteredClaims
}

// InicializarSecreto carga JWT_SECRET y falla si es débil.
// Generarlo con: openssl rand -base64 48
func InicializarSecreto() error {
	s := os.Getenv("JWT_SECRET")
	if len(s) < 32 {
		return errors.New("JWT_SECRET debe tener al menos 32 caracteres")
	}
	secreto = []byte(s)
	return nil
}

// EmitirSesion guarda el token en una cookie HttpOnly, Secure y SameSite=Strict.
func EmitirSesion(w http.ResponseWriter, email, username string) error {
	ahora := time.Now()
	token, err := jwt.NewWithClaims(jwt.SigningMethodHS256, Identidad{
		Email:    email,
		Username: username,
		RegisteredClaims: jwt.RegisteredClaims{
			Issuer:    emisor,
			Subject:   email,
			IssuedAt:  jwt.NewNumericDate(ahora),
			ExpiresAt: jwt.NewNumericDate(ahora.Add(duracionSesion)),
		},
	}).SignedString(secreto)
	if err != nil {
		return err
	}
	http.SetCookie(w, &http.Cookie{
		Name:     nombreCookie,
		Value:    token,
		Path:     "/",
		MaxAge:   int(duracionSesion.Seconds()),
		HttpOnly: true,
		Secure:   true,
		SameSite: http.SameSiteStrictMode,
	})
	return nil
}

func CerrarSesion(w http.ResponseWriter) {
	http.SetCookie(w, &http.Cookie{
		Name:     nombreCookie,
		Value:    "",
		Path:     "/",
		MaxAge:   -1,
		HttpOnly: true,
		Secure:   true,
		SameSite: http.SameSiteStrictMode,
	})
}

// RequerirSesion valida la cookie. El email del contexto es la única identidad.
func RequerirSesion() gin.HandlerFunc {
	return func(c *gin.Context) {
		cookie, err := c.Request.Cookie(nombreCookie)
		if err != nil {
			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "Tenés que iniciar sesión"})
			return
		}
		id := &Identidad{}
		_, err = jwt.ParseWithClaims(cookie.Value, id,
			func(*jwt.Token) (any, error) { return secreto, nil },
			jwt.WithValidMethods([]string{jwt.SigningMethodHS256.Alg()}),
			jwt.WithExpirationRequired(),
			jwt.WithIssuer(emisor),
			jwt.WithIssuedAt(),
		)
		if err != nil {
			c.AbortWithStatusJSON(http.StatusUnauthorized, gin.H{"error": "Tu sesión venció, volvé a iniciar sesión"})
			return
		}
		c.Set("usuario", id)
		c.Set("usuarioEmail", id.Email)
		c.Next()
	}
}
